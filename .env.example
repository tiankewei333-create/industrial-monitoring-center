# Copy to .env before docker compose up
# cp .env.example .env

COMPOSE_PROJECT_NAME=imc

# ---- Ports ----
WEB_PORT=3000
API_PORT=3001
REALTIME_PORT=3002
MQTT_PORT=1883
POSTGRES_PORT=5432
REDIS_PORT=6379
TIMESCALE_PORT=5433

# ---- Auth (change in production) ----
JWT_SECRET=change-me-in-production
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_OBSERVER_USER=observer
DEFAULT_OBSERVER_PASSWORD=observer123

# ---- Database ----
POSTGRES_USER=imc
POSTGRES_PASSWORD=imc_dev_password
POSTGRES_DB=imc

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- MQTT ----
MQTT_URL=mqtt://mosquitto:1883
MQTT_TOPIC_TELEMETRY=imc/telemetry/#

# ---- App ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Local MQTT→WS pipeline ----
# true = realtime 内嵌 Aedes Broker（无需 Docker Mosquitto）
# false = 连接外部 Broker（MQTT_URL，例如 docker compose 里的 mosquitto）
IMC_EMBED_MQTT=true
MQTT_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
SIM_INTERVAL_MS=1000
ASSET_ID=Machine001
VITE_WS_URL=ws://127.0.0.1:3002/ws
