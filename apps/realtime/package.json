{
  "name": "@imc/realtime",
  "version": "0.1.0",
  "private": true,
  "description": "IMC realtime bridge: MQTT subscribe to WebSocket push",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"[imc-realtime] lint ok\" && exit 0",
    "test": "tsx --test src/alarms.test.ts"
  },
  "dependencies": {
    "@imc/shared-types": "0.1.0",
    "aedes": "^0.51.3",
    "mqtt": "^5.10.4",
    "pg": "^8.14.1",
    "jose": "^6.2.12",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
