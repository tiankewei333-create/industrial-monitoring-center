# Copy to `.env` before `docker compose up`
# cp .env.example .env

COMPOSE_PROJECT_NAME=imc

# ---- Ports ----
WEB_PORT=3000
API_PORT=3001
REALTIME_PORT=3002
MQTT_PORT=1883
POSTGRES_PORT=5432
REDIS_PORT=6379
TIMESCALE_PORT=5433

# ---- Auth (change in production) ----
JWT_SECRET=change-me-in-production
# Lab Compose may boot with the default secret. Plant deploy: long random + false.
IMC_ALLOW_DEFAULT_JWT=true
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_OBSERVER_USER=observer
DEFAULT_OBSERVER_PASSWORD=observer123
# CORS_ORIGIN=http://127.0.0.1:3000

# ---- Database ----
POSTGRES_USER=imc
POSTGRES_PASSWORD=imc_dev_password
POSTGRES_DB=imc
DATABASE_URL=postgres://imc:imc_dev_password@127.0.0.1:5432/imc
TIMESCALE_URL=postgres://imc:imc_dev_password@127.0.0.1:5433/imc_ts

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- MQTT ----
# Host processes use localhost. Compose services hardcode mqtt://mosquitto:1883.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=imc
MQTT_PASSWORD=imc_mqtt_password
MQTT_USERNAME=imc
MQTT_TOPIC_TELEMETRY=imc/telemetry/#
SIM_FLEET=all

# ---- App ----
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3001
DB_MIGRATE=true

# ---- Local MQTT → WS pipeline ----
# true  = embed Aedes inside realtime (no Docker Mosquitto required)
# false = use external broker at MQTT_URL
IMC_EMBED_MQTT=true
MQTT_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
SIM_INTERVAL_MS=1000
ASSET_ID=Machine001
# Alarm demo env vars (optional; leave unset for random drift):
# SIM_FORCE_TEMP=86
# SIM_FORCE_POWER=16.5
# SIM_SPIKE=true
# SIM_SPIKE_TEMP=86
# SIM_SPIKE_SEC=15
# SIM_COOL_SEC=20
# SIM_COOL_TEMP=72
# HISTORY_MAX_POINTS=900
# Leave empty to use same-origin /api and /ws (Vite proxy / Docker nginx)
# VITE_WS_URL=ws://127.0.0.1:3002/ws
# VITE_API_URL=http://127.0.0.1:3001
